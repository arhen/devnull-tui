{
  "name": "devnull-tui",
  "version": "0.3.0",
  "description": "Unofficial terminal UI for /dev/null (dev-null.sh), the developers' commit social network",
  "type": "module",
  "bin": {
    "devnull": "index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "run.sh",
    "open.sh",
    "find-node.sh",
    "install.sh",
    "herdr-plugin.toml"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhen/devnull-tui.git"
  },
  "homepage": "https://github.com/arhen/devnull-tui",
  "bugs": {
    "url": "https://github.com/arhen/devnull-tui/issues"
  },
  "license": "MIT",
  "keywords": [
    "devnull",
    "dev-null",
    "tui",
    "terminal",
    "social",
    "herdr",
    "herdr-plugin"
  ],
  "scripts": {
    "start": "node index.js",
    "once": "node index.js --once",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
